/
|-- export.geojson                        # source brute Overpass, inchangée
|-- osmTagMapping.js                       # catégorisation OSM, partagée par les scripts
|-- pool.js / config.js                    # connexion Postgres (inchangés)
|-- script.sql                             # schéma SQL AUTORITAIRE, appliqué par bootstrap.js
|-- bootstrap.js
|
|-- lib/
|   |-- geojsonHelpers.js                  # extraction pure (nom, adresse, coords, réf OSM)
|   `-- slugify.js                         # génère les noms de fichiers lisibles + uniques
|
|-- database/
|   |-- raw/                               # vidage brut par catégorie, jetable, régénéré en entier
|   |   |-- sites.json
|   |   |-- hotels.json
|   |   |-- restaurants.json
|   |   |-- hopitaux.json
|   |   |-- cliniques.json
|   |   `-- pharmacies.json
|   |
|   |-- sites/                             # 1 FICHIER PAR SITE TOURISTIQUE (source de vérité)
|   |   |-- animaux-empailles-w192842105.json     # description + bonASavoir + imageUrl + videoUrl
|   |   |-- blackitude-museum-n6310400747.json
|   |   `-- ... (36 fichiers)
|   |
|   |-- lieux/                             # 1 FICHIER PAR LIEU, PAR CATÉGORIE (pas de videoUrl)
|   |   |-- hotels/
|   |   |   |-- <nom-du-lieu>-<type><osm_id>.json   # description + bonASavoir + imageUrl
|   |   |   `-- ... (345 fichiers)
|   |   |-- restaurants/                   # ... (505 fichiers)
|   |   |-- hopitaux/                      # ... (79 fichiers)
|   |   |-- cliniques/                     # ... (506 fichiers)
|   |   `-- pharmacies/                    # ... (164 fichiers)
|   |
|   `-- assets/                            # images/vidéos LOCALES, référencées en chemin relatif
|       |-- images/
|       |   |-- sites/
|       |   |-- hotels/
|       |   |-- restaurants/
|       |   |-- hopitaux/
|       |   |-- cliniques/
|       |   `-- pharmacies/
|       `-- videos/
|           `-- sites/                     # seuls les sites touristiques ont une vidéo
|
`-- scripts/
    |-- extractCategoriesFromGeojson.js    # export.geojson -> raw/*.json + sites/*.json + lieux/<cat>/*.json
    |                                      # ré-exécutable : met à jour les champs OSM, garde l'édition manuelle
    |-- seedSitesFromDatabase.js           # database/sites/*.json          -> table sites
    `-- seedLieuxFromDatabase.js           # database/lieux/<cat>/*.json    -> table lieux_touristiques
